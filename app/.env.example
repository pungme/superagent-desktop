# Apple notarization credentials, read by electron-builder at release time.
# Copy to .env (gitignored) and fill in. Never commit the real values.
#
# APPLE_APP_SPECIFIC_PASSWORD is an app-specific password generated at
# https://appleid.apple.com → Sign-In and Security → App-Specific Passwords.
# It is NOT your Apple ID password.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=TNNFV3EQZN
